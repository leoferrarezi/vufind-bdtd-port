<?php
    // BDTD: baseado em bootstrap5/templates/RecordTab/staffviewarray.phtml (VuFind 11.1);
    // campos na ordem do Solr (sem ksort) e tabela com a classe do legado.
    // Set page title.
    $this->headTitle($this->translate('Staff View') . ': ' . $this->driver->getBreadcrumb());
?>
<table class="citation table table-striped"><?php /* BDTD: classe do legado */ ?>
  <caption class="visually-hidden"><?=$this->transEsc('Staff View')?></caption>
  <?php
    $rawData = array_filter(
      $this->driver->getRawData(),
      fn ($field) => !preg_match(
        '/^(_version_|spelling|spellingShingle|title_fullStr|title_full_unstemmed|title_sort|identifier_str_mv)$|_(facet|browse)$/',
        $field
      ),
      ARRAY_FILTER_USE_KEY
    );
  ?>
  <?php foreach ($rawData as $field => $values): ?>
    <tr>
      <th scope="row"><?=$this->escapeHtml($field)?></th>
      <td><?=$this->printArrayHtml($values)?></td>
    </tr>
  <?php endforeach; ?>
</table>
